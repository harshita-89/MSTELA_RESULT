rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /subjects/{subjectId}/resources/{resourceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 50 * 1024 * 1024;
    }

    match /assignment_submissions/{assessmentId}/{studentId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == studentId;
    }

    match /assignment_submissions/{assessmentId} {
      allow list: if request.auth != null;
    }

    match /quiz_question_images/{facultyId}/{subjectId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == facultyId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
