rules_version = '2';
 service cloud.firestore {
   match /databases/{database}/documents {
     function isAdmin() {
       return request.auth != null &&
         exists(/databases/$(database)/documents/admins/$(request.auth.uid));
     }

     function isApprovedFaculty() {
       return request.auth != null &&
         exists(/databases/$(database)/documents/faculty/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/faculty/$(request.auth.uid)).data.userRole == 'Faculty' &&
         get(/databases/$(database)/documents/faculty/$(request.auth.uid)).data.approved == true;
     }

     function isSubjectOwner(subjectId) {
       return request.auth != null &&
         exists(/databases/$(database)/documents/subjects/$(subjectId)) &&
         get(/databases/$(database)/documents/subjects/$(subjectId)).data.facultyUID == request.auth.uid;
     }

     match /admins/{uid} {
       allow read: if request.auth != null && (isAdmin() || request.auth.uid == uid);
       allow create, update, delete: if isAdmin();
     }

     match /faculty/{uid} {
       allow read: if request.auth != null && (isAdmin() || request.auth.uid == uid);
       allow create, update: if request.auth != null && request.auth.uid == uid;
       allow delete: if isAdmin();
     }

     match /students/{uid} {
       allow read: if request.auth != null && (isAdmin() || request.auth.uid == uid);
       allow create, update: if request.auth != null && request.auth.uid == uid;
       allow delete: if isAdmin();
     }

     match /subjects/{subjectId} {
       allow read: if request.auth != null;
       allow create: if request.auth != null && (isAdmin() || request.resource.data.facultyUID == request.auth.uid);
       allow update, delete: if request.auth != null && (isAdmin() || request.auth.uid == resource.data.facultyUID);
     }
     match /subjects/{subjectId}/assessments/{assessmentId} {
       allow read: if request.auth != null;
       allow create: if request.auth != null && (isAdmin() || isSubjectOwner(subjectId));
       allow update, delete: if request.auth != null && (isAdmin() || isSubjectOwner(subjectId));
     }

     match /subjects/{subjectId}/resources/{resourceId} {
       allow read: if request.auth != null;
       allow create: if request.auth != null && (isAdmin() || isSubjectOwner(subjectId));
       allow update, delete: if request.auth != null && (isAdmin() || isSubjectOwner(subjectId));
     }

     match /assignmentSubmissions/{submissionId} {
       allow read: if request.auth != null && (
         isAdmin() ||
         resource.data.studentUID == request.auth.uid ||
         (resource.data.subjectId != null && isSubjectOwner(resource.data.subjectId))
       );
       allow create: if request.auth != null && request.resource.data.studentUID == request.auth.uid;
       allow update: if request.auth != null && resource.data.studentUID == request.auth.uid;
       allow delete: if isAdmin() || (request.auth != null && resource.data.studentUID == request.auth.uid);
     }
   }
 }